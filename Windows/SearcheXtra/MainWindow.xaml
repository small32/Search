<Window x:Class="SearcheXtra.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SearcheXtra.Windows" Title="SearcheXtra">
 <Grid x:Name="Root" Background="{ThemeResource Ground}" CornerRadius="10">
  <Grid.Resources><ResourceDictionary>
  <Style x:Key="Quiet" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{ThemeResource Ink}"/><Setter Property="Padding" Value="4"/><Setter Property="MinWidth" Value="26"/><Setter Property="MinHeight" Value="26"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="TabRow" TargetType="ListViewItem"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="TabPlate" CornerRadius="7" Background="Transparent"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="TabPlate.Background" Value="{ThemeResource Wash}"/></VisualState.Setters></VisualState><VisualState x:Name="Selected"><VisualState.Setters><Setter Target="TabPlate.Background" Value="{ThemeResource Wash}"/></VisualState.Setters></VisualState><VisualState x:Name="SelectedPointerOver"><VisualState.Setters><Setter Target="TabPlate.Background" Value="{ThemeResource Hairline}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="TabPlate.Background" Value="{ThemeResource Hairline}"/></VisualState.Setters></VisualState><VisualState x:Name="SelectedPressed"><VisualState.Setters><Setter Target="TabPlate.Background" Value="{ThemeResource Hairline}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="TabContent" x:DataType="local:BrowserTab"><Grid Height="28" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
   <TextBlock Text="{x:Bind LetterDisplay, Mode=OneWay}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
   <Image Source="{x:Bind local:MainWindow.Icon(Favicon), Mode=OneWay}" Width="14" Height="14"/>
   <TextBlock Grid.Column="1" Text="{x:Bind Label, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <Button Grid.Column="2" Style="{StaticResource Quiet}" Content="×" MinWidth="16" MinHeight="16" Width="16" Height="20" Padding="0" Opacity="0" Tag="{x:Bind}" Click="TabCross_Click"/>
   <ProgressBar Grid.ColumnSpan="3" Value="{x:Bind Reading, Mode=OneWay}" Height="1" MinHeight="1" Maximum="100" VerticalAlignment="Bottom" Foreground="#A0A0A0" Background="Transparent" Opacity="0.35" IsHitTestVisible="False"/>
  </Grid></DataTemplate>
  </ResourceDictionary></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="Toolbar" Height="52" Background="Transparent" PointerPressed="DragHeader_Pressed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="Lights" Orientation="Horizontal" Spacing="8" Margin="18,0,0,0" VerticalAlignment="Center">
    <Button Width="12" Height="12" MinWidth="12" MinHeight="12" CornerRadius="6" Background="#FF5F57" BorderThickness="0" Padding="0" Click="CloseWindow_Click" ToolTipService.ToolTip="Close"/>
    <Button Width="12" Height="12" MinWidth="12" MinHeight="12" CornerRadius="6" Background="#FEBC2E" BorderThickness="0" Padding="0" Click="MinimizeWindow_Click" ToolTipService.ToolTip="Minimize"/>
    <Button Width="12" Height="12" MinWidth="12" MinHeight="12" CornerRadius="6" Background="#28C840" BorderThickness="0" Padding="0" Click="MaximizeWindow_Click" ToolTipService.ToolTip="Maximize"/>
   </StackPanel>
   <Grid Grid.Column="1" x:Name="TopStrip"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
    <ListView x:Name="TopTabs" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="Tabs_DragCompleted" SelectionChanged="TopTabs_SelectionChanged" ItemTemplate="{StaticResource TabContent}" ItemContainerStyle="{StaticResource TabRow}" ContainerContentChanging="TabContainer_Changed" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"><ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel></ListView>
    <Button Grid.Column="1" Style="{StaticResource Quiet}" Content="+" Click="NewTab_Click" VerticalAlignment="Center"/>
   </Grid>
   <StackPanel x:Name="Helm" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0,10,0">
    <Button x:Name="BackButton" Style="{StaticResource Quiet}" Content="‹" FontSize="22" Click="Back_Click"/><Button x:Name="ForwardButton" Style="{StaticResource Quiet}" Content="›" FontSize="22" Click="Forward_Click"/><Button Style="{StaticResource Quiet}" Content="↻" FontSize="18" Click="Reload_Click"/>
    <StackPanel x:Name="PinnedExtensions" Orientation="Horizontal" Spacing="2"/><Button x:Name="DownloadsButton" Style="{StaticResource Quiet}" Content="↓" Visibility="Collapsed" Click="Downloads_Click"/>
    <Button x:Name="TopSettings" Style="{StaticResource Quiet}" Content="☷" Click="Settings_Click"/>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="BookmarkScroller" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"><StackPanel x:Name="BookmarkRow" Orientation="Horizontal" Spacing="2" Padding="10,2"/></ScrollViewer>
  <Grid Grid.Row="2" x:Name="Body"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightSidebarColumn" Width="0"/></Grid.ColumnDefinitions>
   <Grid x:Name="Sidebar" Visibility="Collapsed" Padding="10,0" BorderBrush="{ThemeResource Hairline}" BorderThickness="0,0,1,0">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Grid x:Name="SidebarHeader" PointerPressed="DragHeader_Pressed" Background="Transparent"/>
    <Grid Grid.Row="1" x:Name="PinRow" Margin="0,0,0,8"/>
    <StackPanel Grid.Row="2"><ListView x:Name="SideTabs" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="Tabs_DragCompleted" SelectionChanged="SideTabs_SelectionChanged" ItemTemplate="{StaticResource TabContent}" ItemContainerStyle="{StaticResource TabRow}" ContainerContentChanging="TabContainer_Changed"/><Button x:Name="SideNew" Style="{StaticResource Quiet}" Content="+  New tab" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NewTab_Click"/></StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4"><Button x:Name="SettingsButton" Style="{StaticResource Quiet}" Content="☷" Click="Settings_Click" ToolTipService.ToolTip="Settings"/><Button x:Name="SpacesButton" Style="{StaticResource Quiet}" Content="Default" Click="Spaces_Click"/><Button x:Name="MenuButton" Style="{StaticResource Quiet}" Content="···" Click="Menu_Click"/></StackPanel>
   </Grid>
   <Grid x:Name="PageArea" Grid.Column="1"><Grid x:Name="Pages"/><Grid x:Name="Welcome"/>
    <ProgressBar x:Name="LoadingBar" VerticalAlignment="Top" Height="2" IsIndeterminate="True" Visibility="Collapsed" IsHitTestVisible="False"/>
    <Button x:Name="StoreInstall" Style="{StaticResource Quiet}" Content="Add to SearcheXtra" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Visibility="Collapsed" Click="StoreInstall_Click"/>
    <TextBlock x:Name="Status" FontSize="11" Margin="12,2" Opacity="0.65" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
    <Grid x:Name="OmniboxLayer" Background="Transparent" Visibility="Collapsed" Tapped="OmniboxBackdrop_Tapped"><Border Width="560" Height="50" Margin="14,0,14,60" CornerRadius="14" Background="{ThemeResource Ground}" BorderBrush="{ThemeResource Hairline}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="Card_Tapped"><AutoSuggestBox x:Name="Address" Margin="20,5" Background="Transparent" BorderThickness="0" FontSize="16" PlaceholderText="URL / Search" QuerySubmitted="Address_Submitted" TextChanged="Address_Changed" SuggestionChosen="Address_Chosen"/></Border></Grid>
   </Grid>
  </Grid>
  <Grid x:Name="OverlayLayer" Grid.RowSpan="3" Visibility="Collapsed" Background="#50000000" Tapped="OverlayBackdrop_Tapped"/>
 </Grid>
</Window>
